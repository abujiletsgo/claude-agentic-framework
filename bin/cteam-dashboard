#!/usr/bin/env python3
"""cteam-dashboard — Status bar that auto-launches sprint TUI when a sprint starts."""
import curses
import json
import os
import subprocess
import sys
import time
from pathlib import Path

CAF_DIR = Path.home() / "Documents" / "caf-team"
SPRINT_DIR = Path("/tmp/caf_sprint")
DASHBOARD_SCRIPT = CAF_DIR / "dashboard" / "sprint_tui.py"


def get_git_info():
    try:
        branch = subprocess.run(
            ["git", "-C", str(CAF_DIR), "branch", "--show-current"],
            capture_output=True, text=True, timeout=3
        ).stdout.strip()
        short_hash = subprocess.run(
            ["git", "-C", str(CAF_DIR), "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, timeout=3
        ).stdout.strip()
        return branch, short_hash
    except Exception:
        return "?", "?"


def get_remote_status():
    try:
        result = subprocess.run(
            ["git", "-C", str(CAF_DIR), "remote", "-v"],
            capture_output=True, text=True, timeout=3
        ).stdout
        remotes = {}
        for line in result.strip().splitlines():
            parts = line.split()
            if len(parts) >= 2 and "(fetch)" in line:
                remotes[parts[0]] = parts[1].split("/")[-1].replace(".git", "")
        return remotes
    except Exception:
        return {}


def get_active_sprint():
    if not SPRINT_DIR.is_dir():
        return None
    for d in SPRINT_DIR.iterdir():
        if (d / "status.json").exists():
            try:
                data = json.loads((d / "status.json").read_text())
                return {"id": d.name, "leads": data}
            except Exception:
                pass
    return None


def count_assets():
    skills = sum(1 for p in (CAF_DIR / "global-skills").iterdir()
                 if p.is_dir() and not p.name.startswith(".")) if (CAF_DIR / "global-skills").is_dir() else 0
    agents = sum(1 for p in (CAF_DIR / "global-agents").glob("*.md")) if (CAF_DIR / "global-agents").is_dir() else 0
    return skills, agents


def main(stdscr):
    curses.curs_set(0)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_CYAN, -1)
    curses.init_pair(2, curses.COLOR_GREEN, -1)
    curses.init_pair(3, curses.COLOR_YELLOW, -1)
    curses.init_pair(4, curses.COLOR_WHITE, -1)
    curses.init_pair(5, curses.COLOR_MAGENTA, -1)
    curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_CYAN)
    stdscr.timeout(5000)

    last_sprint_check = 0

    while True:
        try:
            stdscr.erase()
            h, w = stdscr.getmaxyx()

            # Check for active sprint
            now = time.time()
            if now - last_sprint_check > 3:
                sprint = get_active_sprint()
                last_sprint_check = now

                # If sprint detected, hand off to the real TUI
                if sprint and DASHBOARD_SCRIPT.exists():
                    curses.endwin()
                    os.execvp("python3", ["python3", str(DASHBOARD_SCRIPT), sprint["id"]])
                    return

            # --- Idle dashboard ---

            # Header bar
            header = " CAF Team Dashboard "
            safe_addstr(stdscr, 0, 0, " " * w, curses.color_pair(6))
            safe_addstr(stdscr, 0, (w - len(header)) // 2, header, curses.color_pair(6) | curses.A_BOLD)

            y = 2
            branch, commit = get_git_info()
            remotes = get_remote_status()
            skills, agents = count_assets()

            # Status line
            status = f"  {branch}  @{commit}  │  {skills} skills  {agents} agents"
            safe_addstr(stdscr, y, 0, status, curses.color_pair(1))
            y += 1

            # Remotes
            if remotes:
                remote_str = "  remotes: " + "  ".join(f"{k}→{v}" for k, v in remotes.items())
                safe_addstr(stdscr, y, 0, remote_str, curses.color_pair(4) | curses.A_DIM)
            y += 2

            # Center message
            msg_y = max(y, h // 2 - 1)
            msg = "Waiting for sprint..."
            safe_addstr(stdscr, msg_y, (w - len(msg)) // 2, msg, curses.color_pair(3))

            hint = "Run /sprint in Claude to start  │  Dashboard auto-activates"
            safe_addstr(stdscr, msg_y + 1, max(0, (w - len(hint)) // 2), hint, curses.A_DIM)

            # Bottom bar
            bar = " q:quit  /sprint:start  "
            safe_addstr(stdscr, h - 1, 0, " " * w, curses.color_pair(6))
            safe_addstr(stdscr, h - 1, (w - len(bar)) // 2, bar, curses.color_pair(6))

            stdscr.refresh()

            key = stdscr.getch()
            if key == ord("q"):
                break

        except KeyboardInterrupt:
            break
        except curses.error:
            pass


def safe_addstr(stdscr, y, x, text, attr=curses.A_NORMAL):
    h, w = stdscr.getmaxyx()
    if y < 0 or y >= h or x >= w:
        return
    try:
        stdscr.addnstr(y, x, text, w - x - 1, attr)
    except curses.error:
        pass


if __name__ == "__main__":
    curses.wrapper(main)
