#!/usr/bin/env python3
# open-task-pane — open a new cmux pane for a task's report
import os
import sys
from pathlib import Path

CAF_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(CAF_DIR / "lib"))
import cmux_client as cmux


def main():
    if len(sys.argv) < 4:
        print(f"Usage: {Path(sys.argv[0]).name} <task_id> <task_name> <task_type>", file=sys.stderr)
        sys.exit(1)

    task_id = sys.argv[1]
    task_name = sys.argv[2]
    task_type = sys.argv[3]

    # Read current session_id
    session_id_file = Path("/tmp/caf_session/current_session_id")
    if not session_id_file.exists():
        print("[open-task-pane] WARNING: no current_session_id found — cmux pane not opened", file=sys.stderr)
        sys.exit(0)

    session_id = session_id_file.read_text().strip()
    if not session_id:
        print("[open-task-pane] WARNING: current_session_id is empty — cmux pane not opened", file=sys.stderr)
        sys.exit(0)

    # Read main_sid for this session
    main_sid_file = Path(f"/tmp/caf_session/{session_id}/main_sid")
    if not main_sid_file.exists():
        print(
            f"[open-task-pane] WARNING: no main_sid found for session {session_id} — cmux pane not opened",
            file=sys.stderr,
        )
        sys.exit(0)

    main_sid = main_sid_file.read_text().strip()
    if not main_sid:
        print("[open-task-pane] WARNING: main_sid is empty — cmux pane not opened", file=sys.stderr)
        sys.exit(0)

    cwd = os.getcwd()
    workspace_id = os.environ.get("CMUX_WORKSPACE_ID", "")

    # Split from main pane (always, so report panes don't nest)
    resp = cmux._call("surface.split", {
        "surface_id": main_sid,
        "workspace_id": workspace_id,
        "direction": "right",
    })

    if not resp.get("ok"):
        error = (resp.get("error") or {})
        code = error.get("code", "")
        msg = error.get("message", str(resp))
        print(f"[open-task-pane] ERROR: surface.split failed ({code}): {msg}", file=sys.stderr)
        sys.exit(1)

    result = resp.get("result") or {}
    new_sid = result.get("surface_id") or result.get("id", "")

    if not new_sid:
        print("[open-task-pane] ERROR: surface.split returned no surface_id", file=sys.stderr)
        sys.exit(1)

    # Send the activity report command to the new pane
    cmd = (
        f"cd {cwd} && uv run python {CAF_DIR}/dashboard/activity_report.py"
        f" --cwd {cwd} --task {task_id}\n"
    )
    cmux.send_surface(new_sid, cmd)

    # Do NOT focus the new pane — leave focus on main

    print(f"[open-task-pane] task {task_id} pane opened")


if __name__ == "__main__":
    main()
