#!/usr/bin/env bash
# gstack-bridge — CAF read-only discovery interface for gstack
# Part of CAF v5.0 Sprint System
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Discover gstack: git subtree location → standalone install → legacy location
if [[ -d "${SCRIPT_DIR}/../global-skills/gstack" ]]; then
  GSTACK_PATH="$(cd "${SCRIPT_DIR}/../global-skills/gstack" && pwd)"
elif [[ -d "${HOME}/.gstack" ]]; then
  GSTACK_PATH="${HOME}/.gstack"
else
  GSTACK_PATH="${HOME}/.claude/skills/gstack"
fi
CACHE_FILE="/tmp/caf_gstack_status.json"
CACHE_TTL=60
UPDATE_THRESHOLD_DAYS=7

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

_now_epoch() {
  date +%s
}

_file_mtime() {
  # prints file mtime as epoch; returns 1 if file missing
  local f="$1"
  if [[ ! -f "$f" ]]; then return 1; fi
  if stat -f %m "$f" 2>/dev/null; then
    return 0
  fi
  # GNU stat fallback
  stat -c %Y "$f" 2>/dev/null
}

_count_skill_dirs() {
  local count=0
  local entry
  for entry in "$GSTACK_PATH"/*/; do
    [[ -d "$entry" ]] || continue
    local base
    base="$(basename "$entry")"
    [[ "$base" == .* ]] && continue
    [[ "$base" == ".git" ]] && continue
    count=$((count + 1))
  done
  printf '%s' "$count"
}

_git_hash() {
  git -C "$GSTACK_PATH" rev-parse --short HEAD 2>/dev/null || printf 'null'
}

_last_commit_epoch() {
  git -C "$GSTACK_PATH" log -1 --format="%ct" 2>/dev/null || printf '0'
}

_bool() {
  if [[ "$1" == "true" ]]; then printf 'true'; else printf 'false'; fi
}

# ---------------------------------------------------------------------------
# status command
# ---------------------------------------------------------------------------

cmd_status() {
  # --- cache read ---
  local now
  now="$(_now_epoch)"
  if [[ -f "$CACHE_FILE" ]]; then
    local mtime
    mtime="$(_file_mtime "$CACHE_FILE" 2>/dev/null)" || mtime=0
    local age=$(( now - mtime ))
    if (( age < CACHE_TTL )); then
      # Extract _exit_code before stripping
      local cached_exit
      cached_exit="$(grep '"_exit_code"' "$CACHE_FILE" 2>/dev/null | grep -oE '[0-9]+' | head -1)" || cached_exit=0
      echo "[gstack-bridge] cache hit (age=${age}s)" >&2
      # Strip _exit_code and _cached_at lines, print the rest
      python3 - "$CACHE_FILE" <<'PYEOF'
import sys, json
try:
    data = json.load(open(sys.argv[1]))
    for k in ("_exit_code", "_cached_at"):
        data.pop(k, None)
    print(json.dumps(data))
except Exception:
    sys.exit(1)
PYEOF
      exit "${cached_exit:-0}"
    fi
  fi

  # --- compute status ---
  local installed="false"
  local path_val="null"
  local git_hash="null"
  local skill_count=0
  local healthy="false"
  local update_needed="false"
  local exit_code=1

  if [[ -d "$GSTACK_PATH" ]]; then
    installed="true"
    path_val="\"${GSTACK_PATH}\""

    local raw_hash
    raw_hash="$(_git_hash)"
    if [[ "$raw_hash" == "null" ]]; then
      git_hash="null"
    else
      git_hash="\"${raw_hash}\""
    fi

    skill_count="$(_count_skill_dirs)"

    if [[ -r "$GSTACK_PATH" ]] && (( skill_count > 0 )); then
      healthy="true"
    fi

    # update_needed: last commit older than UPDATE_THRESHOLD_DAYS
    local threshold_secs=$(( UPDATE_THRESHOLD_DAYS * 86400 ))
    local last_commit
    last_commit="$(_last_commit_epoch)"
    if [[ "$last_commit" != "0" ]] && (( (now - last_commit) > threshold_secs )); then
      update_needed="true"
    fi

    # exit code
    if [[ "$healthy" == "true" ]]; then
      if [[ "$update_needed" == "true" ]]; then
        exit_code=2
      else
        exit_code=0
      fi
    else
      exit_code=3
    fi
  fi

  local json
  json="$(printf '{"installed":%s,"path":%s,"git_hash":%s,"skill_count":%s,"healthy":%s,"update_needed":%s}' \
    "$installed" "$path_val" "$git_hash" "$skill_count" "$healthy" "$update_needed")"

  # --- write cache ---
  local cached_at="$now"
  local cache_json
  cache_json="$(printf '{"installed":%s,"path":%s,"git_hash":%s,"skill_count":%s,"healthy":%s,"update_needed":%s,"_exit_code":%s,"_cached_at":%s}' \
    "$installed" "$path_val" "$git_hash" "$skill_count" "$healthy" "$update_needed" \
    "$exit_code" "$cached_at")"
  printf '%s\n' "$cache_json" > "$CACHE_FILE" 2>/dev/null || true

  printf '%s\n' "$json"
  exit "$exit_code"
}

# ---------------------------------------------------------------------------
# skills command
# ---------------------------------------------------------------------------

cmd_skills() {
  if [[ ! -d "$GSTACK_PATH" ]]; then
    printf '[]\n'
    exit 1
  fi

  local first=1
  local output="["
  local entry base full_path
  for entry in "$GSTACK_PATH"/*/; do
    [[ -d "$entry" ]] || continue
    base="$(basename "$entry")"
    [[ "$base" == .* ]] && continue
    [[ "$base" == ".git" ]] && continue
    # Remove trailing slash from entry
    full_path="${entry%/}"
    if (( first )); then
      output="${output}{\"name\":\"/${base}\",\"path\":\"${full_path}\"}"
      first=0
    else
      output="${output},{\"name\":\"/${base}\",\"path\":\"${full_path}\"}"
    fi
  done
  output="${output}]"
  printf '%s\n' "$output"
  exit 0
}

# ---------------------------------------------------------------------------
# check command
# ---------------------------------------------------------------------------

cmd_check() {
  if [[ ! -d "$GSTACK_PATH" ]]; then
    printf '[check] gstack: NOT INSTALLED\n' >&2
    exit 1
  fi

  local all_ok=0

  # 1. Check symlinks are valid (not dangling)
  local symlink_ok=1
  local link
  while IFS= read -r -d '' link; do
    if [[ ! -e "$link" ]]; then
      printf '[check] symlinks: DANGLING -> %s\n' "$link" >&2
      symlink_ok=0
    fi
  done < <(find "$GSTACK_PATH" -maxdepth 2 -type l -print0 2>/dev/null)
  if (( symlink_ok )); then
    printf '[check] symlinks: OK\n' >&2
  else
    all_ok=3
  fi

  # 2. Check GSTACK_PATH/CLAUDE.md exists and is non-empty
  if [[ -s "${GSTACK_PATH}/CLAUDE.md" ]]; then
    printf '[check] CLAUDE.md: OK\n' >&2
  else
    printf '[check] CLAUDE.md: MISSING\n' >&2
    all_ok=3
  fi

  # 3. Check ~/.gstack/ directory exists
  if [[ -d "${HOME}/.gstack" ]]; then
    printf '[check] ~/.gstack/: OK\n' >&2
  else
    printf '[check] ~/.gstack/: MISSING\n' >&2
    all_ok=3
  fi

  exit "$all_ok"
}

# ---------------------------------------------------------------------------
# update command
# ---------------------------------------------------------------------------

cmd_update() {
  if [[ ! -d "$GSTACK_PATH" ]]; then
    printf '[gstack-bridge] gstack not installed at %s\n' "$GSTACK_PATH" >&2
    exit 1
  fi

  local setup_script="${GSTACK_PATH}/setup"
  if [[ ! -f "$setup_script" ]]; then
    printf '[gstack-bridge] setup script not found: %s\n' "$setup_script" >&2
    exit 3
  fi

  exec "$setup_script"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

COMMAND="${1:-}"
case "$COMMAND" in
  status)  cmd_status  ;;
  skills)  cmd_skills  ;;
  check)   cmd_check   ;;
  update)  cmd_update  ;;
  *)
    printf 'Usage: gstack-bridge {status|skills|check|update}\n' >&2
    exit 1
    ;;
esac
