#!/usr/bin/env python3
"""
sprint-event — thin wrapper around orch-event for sprint-mode compatibility.

Usage: sprint-event <sprint_id> <wave> <role> <status> [<summary>]
       sprint-event <sprint_id> <event_type> [<payload>]   (legacy 2-arg form)

Delegates to bin/orch-event with the same arguments.
"""
import sys
import subprocess
from pathlib import Path

CAF_DIR = Path(__file__).resolve().parent.parent
orch_event = CAF_DIR / "bin" / "orch-event"

if not orch_event.exists():
    # Silently no-op if orch-event also missing
    sys.exit(0)

try:
    subprocess.run([str(orch_event)] + sys.argv[1:], check=False)
except Exception:
    pass
