#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["anthropic>=0.50.0"]
# ///
"""
bin/advisor — Sonnet executor + Opus advisor using the official advisor_20260301 API tool.

Usage:
  bin/advisor "your task here"
  echo "task" | bin/advisor
  bin/advisor --model haiku "task"   # Haiku executor + Opus advisor

The executor (Sonnet or Haiku) runs the task end-to-end and autonomously consults
Opus mid-generation when it encounters decision forks, irreversible actions, or
genuine ambiguity. All within a single API request — no extra round trips.

Prints:
  - Full assistant output (with advisor call markers)
  - Token cost breakdown per iteration
  - Total estimated cost in USD
"""

import sys
import os
import json
import argparse

SYSTEM_PROMPT_TIMING = """You have access to an `advisor` tool backed by a stronger reviewer model (Opus).
It takes NO parameters — when you call advisor(), your entire conversation history is automatically forwarded.
They see the task, every tool call you've made, every result you've seen.

Call advisor BEFORE substantive work — before writing, before committing to an interpretation,
before building on an assumption. If orientation is needed first (reading files, fetching context),
do that, then call advisor. Orientation is not substantive work. Writing, editing, and declaring
an answer are.

Also call advisor:
- When you believe the task is complete. BEFORE this call, make your deliverable durable.
- When stuck — errors recurring, approach not converging.
- When considering a change of approach.

On tasks longer than a few steps, call advisor at least once before committing to an approach
and once before declaring done.
"""

SYSTEM_PROMPT_ADVICE = """Give the advice serious weight. If you follow a step and it fails empirically,
or you have primary-source evidence that contradicts a specific claim, adapt.
A passing self-test is not evidence the advice is wrong.

If you've already retrieved data pointing one way and the advisor points another:
surface the conflict in one more advisor call — "I found X, you suggest Y, which constraint
breaks the tie?" The advisor saw your evidence but may have underweighted it.
"""

# Pricing per 1M tokens (USD) as of April 2026
PRICING = {
    "claude-sonnet-4-6": {"input": 3.00, "output": 15.00},
    "claude-haiku-4-5-20251001": {"input": 0.80, "output": 4.00},
    "claude-opus-4-6": {"input": 15.00, "output": 75.00},
}


def estimate_cost(usage_iterations: list, executor_model: str) -> dict:
    """Calculate cost from usage.iterations breakdown."""
    total_input_usd = 0.0
    total_output_usd = 0.0
    advisor_calls = 0

    for it in usage_iterations:
        itype = it.get("type", "message")
        if itype == "advisor_message":
            advisor_calls += 1
            model = it.get("model", "claude-opus-4-6")
            rates = PRICING.get(model, PRICING["claude-opus-4-6"])
        else:
            rates = PRICING.get(executor_model, PRICING["claude-sonnet-4-6"])

        inp = it.get("input_tokens", 0) + it.get("cache_read_input_tokens", 0)
        out = it.get("output_tokens", 0)
        total_input_usd += inp * rates["input"] / 1_000_000
        total_output_usd += out * rates["output"] / 1_000_000

    return {
        "advisor_calls": advisor_calls,
        "total_usd": total_input_usd + total_output_usd,
        "input_usd": total_input_usd,
        "output_usd": total_output_usd,
    }


def run(task: str, executor_model: str = "claude-sonnet-4-6", max_advisor_uses: int = 5):
    try:
        import anthropic
    except ImportError:
        print("ERROR: anthropic package not found. Run: uv pip install anthropic>=0.50.0", file=sys.stderr)
        sys.exit(1)

    client = anthropic.Anthropic()

    print(f"\n{'='*60}", file=sys.stderr)
    print(f"Executor: {executor_model}", file=sys.stderr)
    print(f"Advisor:  claude-opus-4-6 (max {max_advisor_uses} calls)", file=sys.stderr)
    print(f"Beta:     advisor-tool-2026-03-01", file=sys.stderr)
    print(f"{'='*60}\n", file=sys.stderr)

    system = SYSTEM_PROMPT_TIMING + "\n" + SYSTEM_PROMPT_ADVICE

    response = client.beta.messages.create(
        model=executor_model,
        max_tokens=8192,
        betas=["advisor-tool-2026-03-01"],
        system=system,
        tools=[
            {
                "type": "advisor_20260301",
                "name": "advisor",
                "model": "claude-opus-4-6",
                "max_uses": max_advisor_uses,
                "caching": {"type": "ephemeral", "ttl": "5m"},
            }
        ],
        messages=[{"role": "user", "content": task}],
    )

    # Print assistant output
    advisor_calls_made = 0
    for block in response.content:
        btype = getattr(block, "type", "")
        if btype == "text":
            print(block.text)
        elif btype == "server_tool_use" and getattr(block, "name", "") == "advisor":
            advisor_calls_made += 1
            print(f"\n[advisor call #{advisor_calls_made}]\n", file=sys.stderr)
        elif btype == "advisor_tool_result":
            content = getattr(block, "content", None)
            if content:
                advice_text = getattr(content, "text", str(content))
                print(f"[advisor said]: {advice_text[:300]}...\n" if len(advice_text) > 300 else f"[advisor said]: {advice_text}\n", file=sys.stderr)

    # Cost breakdown
    iterations = []
    if hasattr(response, "usage") and hasattr(response.usage, "iterations"):
        iterations = response.usage.iterations or []

    cost = estimate_cost(iterations, executor_model)

    print(f"\n{'─'*60}", file=sys.stderr)
    print(f"Advisor calls:  {cost['advisor_calls']}", file=sys.stderr)
    print(f"Stop reason:    {response.stop_reason}", file=sys.stderr)
    print(f"Cost estimate:  ${cost['total_usd']:.4f} (in: ${cost['input_usd']:.4f}, out: ${cost['output_usd']:.4f})", file=sys.stderr)
    if iterations:
        print(f"Iterations:     {len(iterations)}", file=sys.stderr)
        for i, it in enumerate(iterations):
            itype = it.get("type", "message") if isinstance(it, dict) else getattr(it, "type", "message")
            inp = (it.get("input_tokens", 0) if isinstance(it, dict) else getattr(it, "input_tokens", 0))
            out = (it.get("output_tokens", 0) if isinstance(it, dict) else getattr(it, "output_tokens", 0))
            model = (it.get("model", executor_model) if isinstance(it, dict) else getattr(it, "model", executor_model))
            print(f"  [{i+1}] {itype:<20} in={inp:>5}  out={out:>5}  model={model}", file=sys.stderr)
    print(f"{'─'*60}\n", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description="Run a task with Sonnet/Haiku + Opus advisor")
    parser.add_argument("task", nargs="?", help="Task description (or pipe via stdin)")
    parser.add_argument("--model", default="sonnet",
                        choices=["sonnet", "haiku", "claude-sonnet-4-6", "claude-haiku-4-5-20251001"],
                        help="Executor model (default: sonnet)")
    parser.add_argument("--max-advisor", type=int, default=5,
                        help="Max advisor calls per request (default: 5)")

    args = parser.parse_args()

    task = args.task
    if not task:
        if not sys.stdin.isatty():
            task = sys.stdin.read().strip()
        else:
            print("Usage: bin/advisor 'your task'", file=sys.stderr)
            sys.exit(1)

    model_map = {
        "sonnet": "claude-sonnet-4-6",
        "haiku": "claude-haiku-4-5-20251001",
    }
    executor = model_map.get(args.model, args.model)

    run(task, executor_model=executor, max_advisor_uses=args.max_advisor)


if __name__ == "__main__":
    main()
