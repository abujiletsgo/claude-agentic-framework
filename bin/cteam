#!/usr/bin/env bash
# cteam — Launch CAF Team workspace with tmux dashboard
set -euo pipefail

SESSION="caf-team"
CAF_DIR="${HOME}/Documents/caf-team"
DASHBOARD="${CAF_DIR}/dashboard/sprint_tui.py"

# Already inside this session? Just restart dashboard pane if needed.
if [[ "${TMUX_SESSION:-}" == "$SESSION" ]]; then
  echo "Already in $SESSION session."
  exit 0
fi

# Attach if session exists
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# Create new session: main pane (claude), bottom pane (dashboard)
tmux new-session -d -s "$SESSION" -c "$CAF_DIR" -x "$(tput cols)" -y "$(tput lines)"

# Bottom pane: dashboard (28% height), starts with a placeholder until a sprint runs
tmux split-window -t "$SESSION" -v -l '28%' -c "$CAF_DIR" \
  "echo '⏳ No active sprint. Dashboard starts when you run /sprint.'; \
   echo '   Or launch manually: uv run ${DASHBOARD} <sprint-id>'; \
   exec bash"

# Top pane: Claude Code
tmux select-pane -t "$SESSION:0.0"
tmux send-keys -t "$SESSION:0.0" "claude" Enter

# Set env for sprint system
tmux set-environment -t "$SESSION" CAF_DIR "$CAF_DIR"

# Attach
exec tmux attach -t "$SESSION"
