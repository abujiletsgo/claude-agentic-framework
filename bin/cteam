#!/usr/bin/env bash
# cteam — CAF workspace launcher (cmux-native)
# Requires: cmux with a fresh tab (Cmd+T)
#
# Layout:
#   [main: claude]  │  [dashboard: sprint_report.py idle]  │  [report: activity_report.py]
#   (dashboard/report panels only open if those scripts exist in the project)
set -euo pipefail

REPO_DIR="${PWD}"
CAF_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [ -z "${CMUX_SURFACE_ID:-}" ]; then
  echo "[cteam] not running inside cmux." >&2
  echo "[cteam] open a new cmux tab (Cmd+T) and run cteam there." >&2
  exit 1
fi

export CTEAM_REPO_DIR="$REPO_DIR"
export CTEAM_CAF_DIR="$CAF_DIR"
export CTEAM_DASHBOARD_CMD="uv run python ${CAF_DIR}/dashboard/sprint_report.py --cwd ${REPO_DIR}"
export CTEAM_REPORT_CMD="uv run python ${CAF_DIR}/dashboard/activity_report.py --cwd ${REPO_DIR}"
export SESSION_ID="${SESSION_ID:-session_$(date -u +%Y%m%d_%H%M%S)}"

python3 <<'PYEOF'
import sys, os
sys.path.insert(0, os.environ['CTEAM_CAF_DIR'] + '/lib')
import cmux_client as cmux

repo_dir    = os.environ['CTEAM_REPO_DIR']
dash_cmd    = os.environ['CTEAM_DASHBOARD_CMD']
report_cmd  = os.environ['CTEAM_REPORT_CMD']
main_sid    = os.environ.get('CMUX_SURFACE_ID', '')
wid         = os.environ.get('CMUX_WORKSPACE_ID', '')

import pathlib as _pl, datetime as _dt, os as _os

# Session init — write main_sid so open-task-pane knows which surface to split from
_session_id = _os.environ.get('SESSION_ID') or \
    'session_' + _dt.datetime.now(_dt.timezone.utc).strftime('%Y%m%d_%H%M%S')
_session_dir = _pl.Path(f'/tmp/caf_session/{_session_id}')
_session_dir.mkdir(parents=True, exist_ok=True)
(_session_dir / 'main_sid').write_text(main_sid)
_pl.Path('/tmp/caf_session/current_session_id').write_text(_session_id)
_os.environ['SESSION_ID'] = _session_id

def split(from_sid):
    resp = cmux._call('surface.split', {
        'surface_id': from_sid,
        'workspace_id': wid,
        'direction': 'right',
    })
    if not resp.get('ok'):
        code = (resp.get('error') or {}).get('code', '')
        msg  = (resp.get('error') or {}).get('message', str(resp))
        if code in ('unavailable', 'not_found'):
            print('[cteam] cmux workspace not found — your env vars are stale.', file=sys.stderr)
            print('[cteam] open a fresh cmux tab (Cmd+T) and run cteam there.', file=sys.stderr)
            sys.exit(0)
        print(f'[cteam] split failed: {msg}', file=sys.stderr)
        return None
    result = resp.get('result') or {}
    return result.get('surface_id') or result.get('id') or None

dash_sid = split(main_sid)
if dash_sid:
    cmux.send_surface(dash_sid, f'cd {repo_dir} && {dash_cmd}\n')
    report_sid = split(dash_sid)
    if report_sid:
        cmux.send_surface(report_sid, f'cd {repo_dir} && {report_cmd}\n')

cmux.focus_surface(main_sid)
PYEOF

cd "${REPO_DIR}"
exec claude
