#!/usr/bin/env bash
# cteam — Launch CAF Team workspace with tmux dashboard + session sidebar
set -euo pipefail

SESSION="caf-team"
CAF_DIR="${HOME}/Documents/caf-team"
SIDEBAR="${CAF_DIR}/bin/cteam-sidebar"
BUDDY="${CAF_DIR}/bin/cteam-buddy"
DASHBOARD="${CAF_DIR}/dashboard/sprint_tui.py"

# Already inside this session? Just restart dashboard pane if needed.
if [[ "${TMUX_SESSION:-}" == "$SESSION" ]]; then
  echo "Already in $SESSION session."
  exit 0
fi

# Attach if session exists
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# ┌──────────────────────┬─────────────┐
# │                      │  Sessions   │
# │    Claude Code       │  (sidebar)  │
# │    (main)            ├─────────────┤
# │                      │  🐱 Buddy   │
# ├──────────────────────┴─────────────┤
# │  Dashboard / Sprint TUI            │
# └────────────────────────────────────┘

# Create session with main pane
tmux new-session -d -s "$SESSION" -c "$CAF_DIR" -x "$(tput cols)" -y "$(tput lines)"

# Bottom pane: dashboard (25% height, full width)
tmux split-window -t "$SESSION:0.0" -v -l '25%' -c "$CAF_DIR" \
  "python3 ${CAF_DIR}/bin/cteam-dashboard"

# Right sidebar: session manager (22% width, top area only)
tmux split-window -t "$SESSION:0.0" -h -l '22%' -c "$CAF_DIR" \
  "python3 ${SIDEBAR}"

# Buddy pane: below sidebar (30% of right column height)
tmux split-window -t "$SESSION:0.1" -v -l '30%' -c "$CAF_DIR" \
  "python3 ${BUDDY}"

# Enable mouse (clickable panes, sidebar, scroll)
tmux set-option -t "$SESSION" -g mouse on

# Select main pane (top-left) and launch Claude
tmux select-pane -t "$SESSION:0.0"
tmux send-keys -t "$SESSION:0.0" "claude" Enter

# Set env for sprint system
tmux set-environment -t "$SESSION" CAF_DIR "$CAF_DIR"

# Attach
exec tmux attach -t "$SESSION"
