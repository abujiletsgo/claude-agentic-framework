#!/usr/bin/env bash
# cteam — Launch CAF Team workspace with tmux dashboard + session sidebar + buddy
set -euo pipefail

SESSION="caf-team"
CAF_DIR="${HOME}/Documents/caf-team"
SIDEBAR="${CAF_DIR}/bin/cteam-sidebar"
BUDDY="${CAF_DIR}/bin/cteam-buddy"

# Already inside this session? Just restart dashboard pane if needed.
if [[ "${TMUX_SESSION:-}" == "$SESSION" ]]; then
  echo "Already in $SESSION session."
  exit 0
fi

# --reset: kill and recreate
if [[ "${1:-}" == "--reset" ]]; then
  tmux kill-session -t "$SESSION" 2>/dev/null || true
fi

# Attach if session exists
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach -t "$SESSION"
fi

# ┌──────────────────────┬─────────────┐
# │                      │  Sessions   │
# │    Claude Code       │  (sidebar)  │
# │    (main)            ├─────────────┤
# │                      │  Buddy      │
# ├──────────────────────┴─────────────┤
# │  Dashboard                         │
# └────────────────────────────────────┘

# Step 1: Create session — single pane (will become top-left / Claude)
tmux new-session -d -s "$SESSION" -c "$CAF_DIR" -x "$(tput cols)" -y "$(tput lines)"

# Step 2: Split bottom for dashboard (25% height)
# Layout: [main] on top, [dashboard] on bottom
tmux split-window -t "${SESSION}:0" -v -l '25%' -c "$CAF_DIR" \
  "python3 ${CAF_DIR}/bin/cteam-dashboard"

# Step 3: Split the top pane (main) horizontally for sidebar (22% width)
# Target pane 0 = top pane (main). After split: [main | sidebar] on top, [dashboard] on bottom
tmux split-window -t "${SESSION}:0.0" -h -l '22%' -c "$CAF_DIR" \
  "python3 ${SIDEBAR}"

# Step 4: Now panes are: 0=main, 1=sidebar, 2=dashboard
# Split the SIDEBAR pane vertically for buddy (40% of sidebar height)
tmux split-window -t "${SESSION}:0.1" -v -l '40%' -c "$CAF_DIR" \
  "python3 ${BUDDY}"

# Now panes are: 0=main(claude), 1=sidebar, 2=buddy, 3=dashboard

# Enable mouse
tmux set-option -t "$SESSION" -g mouse on

# Launch Claude in the main pane
tmux select-pane -t "${SESSION}:0.0"
tmux send-keys -t "${SESSION}:0.0" "claude" Enter

# Set env for sprint system
tmux set-environment -t "$SESSION" CAF_DIR "$CAF_DIR"

# Attach
exec tmux attach -t "$SESSION"
