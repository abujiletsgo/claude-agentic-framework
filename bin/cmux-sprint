#!/usr/bin/env python3
"""
cmux-sprint — launch and coordinate sprint leads as real cmux panes.

Subcommands:
  launch-lead <sprint_id> <role> <wave>   Open a new pane with an interactive claude session
  poll-wave   <sprint_id> <wave>          Poll until all roles in the wave are done/failed
  gate        <sprint_id> <wave>          Unlock the next wave in gate.json
"""

import sys
import os
import json
import time
import subprocess
from pathlib import Path

# ---------------------------------------------------------------------------
# Bootstrap: add lib/ to sys.path so we can import cmux_client
# ---------------------------------------------------------------------------
CAF_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(CAF_DIR / "lib"))
import cmux_client as cmux  # noqa: E402 (after sys.path manipulation)

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
SPRINT_BASE = Path("/tmp/caf_sprint")

WAVE_ROLES: dict[int, list[str]] = {
    0: ["planning-lead"],
    1: ["engineering-lead", "frontend-lead", "review-lead"],
    2: ["qa-lead", "security-lead"],
    3: ["release-lead", "docs-lead"],
}

POLL_INTERVAL = 5        # seconds between status checks
POLL_TIMEOUT  = 30 * 60  # 30-minute hard timeout


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def sprint_dir(sprint_id: str) -> Path:
    return SPRINT_BASE / sprint_id


def status_path(sprint_id: str, role: str) -> Path:
    return sprint_dir(sprint_id) / f"{role}.status"


def read_status(sprint_id: str, role: str) -> str | None:
    """Return status string or None if the file is missing / unreadable."""
    p = status_path(sprint_id, role)
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text())["status"]
    except Exception:
        return None


def write_status(sprint_id: str, role: str, status: str) -> None:
    path = status_path(sprint_id, role)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"status": status}))


def call_sprint_event(sprint_id: str, event_type: str, payload: str = "") -> None:
    event_bin = CAF_DIR / "bin" / "sprint-event"
    cmd = [str(event_bin), sprint_id, event_type]
    if payload:
        cmd.append(payload)
    try:
        subprocess.run(cmd, check=False)
    except Exception as exc:
        print(f"[cmux-sprint] sprint-event call failed: {exc}", file=sys.stderr)


def get_sprint_cwd(sprint_id: str) -> str:
    cwd_file = sprint_dir(sprint_id) / "cwd"
    if cwd_file.exists():
        return cwd_file.read_text().strip()
    return os.environ.get("PWD", str(Path.cwd()))


# ---------------------------------------------------------------------------
# Subcommand: launch-lead
# ---------------------------------------------------------------------------

def cmd_launch_lead(sprint_id: str, role: str, wave: int) -> None:
    sd = sprint_dir(sprint_id)
    prompt_path = sd / "prompts" / f"{role}.md"

    if not prompt_path.exists():
        print(f"[cmux-sprint] prompt not found: {prompt_path}", file=sys.stderr)
        sys.exit(1)

    prompt_text = prompt_path.read_text()

    # Mark as running before we open the pane
    write_status(sprint_id, role, "running")
    call_sprint_event(sprint_id, "lead_started")

    # Remember the calling surface so we can focus back later
    original_sid = os.environ.get("CMUX_SURFACE_ID", "")

    # Split right to get a new pane
    try:
        new_sid = cmux.new_split(direction="right")
    except Exception as exc:
        print(f"[cmux-sprint] surface.split failed: {exc}", file=sys.stderr)
        sys.exit(1)

    if not new_sid:
        print("[cmux-sprint] surface.split returned no surface_id", file=sys.stderr)
        sys.exit(1)

    # cd to sprint cwd then launch claude interactively
    cwd = get_sprint_cwd(sprint_id)
    cmux.send_surface(new_sid, f"cd {cwd}\n")
    cmux.send_surface(new_sid, "claude\n")

    # Give claude time to initialise before sending the prompt
    time.sleep(1)

    # Send the prompt text followed by Enter so claude starts processing
    cmux.send_surface(new_sid, prompt_text + "\n")

    # Return focus to the pane that called us
    if original_sid:
        try:
            cmux.focus_surface(original_sid)
        except Exception:
            pass  # non-fatal

    print(f"[cmux-sprint] launched {role} (wave {wave}) in pane {new_sid}")


# ---------------------------------------------------------------------------
# Subcommand: poll-wave
# ---------------------------------------------------------------------------

def cmd_poll_wave(sprint_id: str, wave: int) -> None:
    roles = WAVE_ROLES.get(wave)
    if roles is None:
        print(f"[cmux-sprint] unknown wave: {wave}", file=sys.stderr)
        sys.exit(1)

    print(f"[cmux-sprint] polling wave {wave} roles: {', '.join(roles)}")
    deadline = time.time() + POLL_TIMEOUT

    while True:
        if time.time() > deadline:
            print(
                f"[cmux-sprint] WARNING: poll-wave {wave} timed out after 30 minutes.",
                file=sys.stderr,
            )
            return

        statuses = {role: read_status(sprint_id, role) for role in roles}
        terminal = {"done", "failed"}
        pending = [r for r, s in statuses.items() if s not in terminal]

        if not pending:
            failed = [r for r, s in statuses.items() if s == "failed"]
            if failed:
                print(
                    f"[cmux-sprint] WARNING: wave {wave} completed with failures: {', '.join(failed)}",
                    file=sys.stderr,
                )
            else:
                print(f"[cmux-sprint] wave {wave} complete — all roles done.")
            return

        print(
            f"[cmux-sprint] wave {wave}: waiting on {', '.join(pending)} …",
            flush=True,
        )
        time.sleep(POLL_INTERVAL)


# ---------------------------------------------------------------------------
# Subcommand: gate
# ---------------------------------------------------------------------------

def cmd_gate(sprint_id: str, wave: int) -> None:
    sd = sprint_dir(sprint_id)
    sd.mkdir(parents=True, exist_ok=True)
    gate_path = sd / "gate.json"

    if gate_path.exists():
        try:
            gate = json.loads(gate_path.read_text())
        except Exception:
            gate = {}
    else:
        gate = {}

    unlocked: list[int] = gate.get("unlocked_waves", [])
    next_wave = wave + 1

    if next_wave not in unlocked:
        unlocked.append(next_wave)

    gate["unlocked_waves"] = unlocked
    gate_path.write_text(json.dumps(gate, indent=2))

    call_sprint_event(sprint_id, "gate_unlocked", json.dumps({"wave": next_wave}))
    print(f"[cmux-sprint] gate: wave {next_wave} unlocked. gate.json -> {gate}")


# ---------------------------------------------------------------------------
# Usage / dispatch
# ---------------------------------------------------------------------------

USAGE = """\
Usage: cmux-sprint <subcommand> [args...]

Subcommands:
  launch-lead <sprint_id> <role> <wave>
      Open a new cmux pane for <role> and start an interactive claude session
      with the role's prompt.

  poll-wave <sprint_id> <wave>
      Block until all roles in <wave> have status done or failed (or timeout).

  gate <sprint_id> <wave>
      Unlock wave+1 in gate.json and emit a gate_unlocked event.

Wave->role mapping:
  0  planning-lead
  1  engineering-lead, frontend-lead, review-lead
  2  qa-lead, security-lead
  3  release-lead, docs-lead
"""


def main() -> None:
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help"):
        print(USAGE)
        return

    subcmd = args[0]

    if subcmd == "launch-lead":
        if len(args) < 4:
            print("Usage: cmux-sprint launch-lead <sprint_id> <role> <wave>", file=sys.stderr)
            sys.exit(1)
        cmd_launch_lead(args[1], args[2], int(args[3]))

    elif subcmd == "poll-wave":
        if len(args) < 3:
            print("Usage: cmux-sprint poll-wave <sprint_id> <wave>", file=sys.stderr)
            sys.exit(1)
        cmd_poll_wave(args[1], int(args[2]))

    elif subcmd == "gate":
        if len(args) < 3:
            print("Usage: cmux-sprint gate <sprint_id> <wave>", file=sys.stderr)
            sys.exit(1)
        cmd_gate(args[1], int(args[2]))

    else:
        print(f"[cmux-sprint] unknown subcommand: {subcmd!r}", file=sys.stderr)
        print(USAGE, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
