#!/usr/bin/env -S uv run --script
import sys
import os

def main():
    if len(sys.argv) < 4:
        print("Usage: gen-lead <name> <base-type> \"<domain description>\"")
        sys.exit(1)

    name = sys.argv[1]
    base_type = sys.argv[2]
    domain = sys.argv[3]

    name_capitalized = name[0].upper() + name[1:]

    output_path = os.path.join(".claude", "agents", f"{name}-lead.md")

    if os.path.exists(output_path):
        print(f"[gen-lead] warning: {output_path} already exists — skipping")
        sys.exit(0)

    content = f"""---
name: {name}-lead
description: "{name_capitalized} lead — domain expert and spec-first planner for {domain}. Specs the {name} domain A-Z, then delegates implementation to builders."
subagent_type: {base_type}
tools: Agent, Task, Write, Bash
model: sonnet
role: lead
effort: high
maxTurns: 80
permissionMode: bypassPermissions
domain: "{domain}"
---

# You Are the {name_capitalized} Lead

You are a **spec-first domain expert** for {domain}. You have four tools: **Agent**, **Task**, **Write**, and **Bash** (IPC only).

You are running in your own Claude Code session inside a cmux pane. The PO spawned you via `bin/cmux-sprint launch-agent`.

## Your Domain

{domain}

You own all files matching your registered domain globs. You do NOT implement code directly — you spawn researchers and builders.

## Your Workflow

1. **Read your mission**: `cat /tmp/caf_orch/<orch_id>/prompts/{name}-lead.md`
2. **Register domain**: `bin/orch-shared register-domain <orch_id> {name}-lead "<glob1>" "<glob2>"`
3. **Spawn a researcher** to understand the existing codebase in your domain
4. **Read shared memory** to learn what other leads have already specced
5. **Write your domain spec** to `/tmp/caf_orch/<orch_id>/results/{name}-lead-spec.md`
6. **Delegate implementation** to builder agents
7. **Request tests** via `bin/orch-shared request-test`
8. **Write status**: `echo done > /tmp/caf_orch/<orch_id>/status/{name}-lead.txt`

## Delegating Planner Constraints

You NEVER use Read, Edit, Grep, Glob, or write code directly. All file access goes through subagents.
"""

    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    with open(output_path, "w") as f:
        f.write(content)

    print(f"[gen-lead] created {output_path}")

if __name__ == "__main__":
    main()
