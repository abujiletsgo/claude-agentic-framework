#!/usr/bin/env python3
"""cteam-buddy — Animated companion widget for the cteam dashboard."""
import curses
import json
import random
import sys
import time
from pathlib import Path

# Add lib/ to path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from buddies import BUDDIES, BUDDY_LIST, STATE_MOOD_MAP, STATE_REACTION_MAP

CAF_DIR = Path.home() / "Documents" / "caf-team"
BUDDY_FILE = CAF_DIR / ".claude" / "buddy.json"
SPRINT_DIR = Path("/tmp/caf_sprint")

TICK_MS = 600  # animation frame rate — 600ms per frame


def load_buddy():
    try:
        return json.loads(BUDDY_FILE.read_text()).get("active", "cat")
    except Exception:
        return "cat"


def save_buddy(name):
    BUDDY_FILE.parent.mkdir(parents=True, exist_ok=True)
    BUDDY_FILE.write_text(json.dumps({"active": name}) + "\n")


def detect_state():
    if SPRINT_DIR.is_dir():
        for d in SPRINT_DIR.iterdir():
            sf = d / "status.json"
            if sf.exists():
                try:
                    data = json.loads(sf.read_text())
                    states = [
                        v.get("status", "") if isinstance(v, dict) else ""
                        for v in data.values()
                    ]
                    if any(s == "failed" for s in states):
                        return "sprint_fail"
                    if any(s == "running" for s in states):
                        return "build"
                    if all(s == "done" for s in states if s):
                        return "sprint_done"
                    return "sprint_start"
                except Exception:
                    pass
    return "idle"


class BuddyWidget:
    def __init__(self, stdscr):
        self.stdscr = stdscr
        self.current = load_buddy()
        self.last_state = "idle"
        self.idle_ticks = 0

        # Animation state
        self.mood = "idle"          # current animation set
        self.frame_idx = 0          # current frame within animation
        self.anim_type = "loop"     # "loop" or "oneshot"
        self.oneshot_done = False    # True when oneshot finished playing
        self.position_offset = 0    # horizontal drift (-2 to +2)
        self.drift_dir = 1          # 1 or -1

        # Speech
        self.message = ""
        self.message_timer = 0

        # Timing
        self.last_tick = time.time()
        self.state_check_interval = 5  # check sprint state every N ticks
        self.ticks_since_state_check = 0

    def run(self):
        curses.curs_set(0)
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        self.stdscr.timeout(TICK_MS)
        print("\033[?1003h", end="", flush=True)  # mouse tracking

        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)     # art
        curses.init_pair(2, curses.COLOR_YELLOW, -1)    # speech
        curses.init_pair(3, curses.COLOR_GREEN, -1)     # active button
        curses.init_pair(4, curses.COLOR_MAGENTA, -1)   # name
        curses.init_pair(5, curses.COLOR_WHITE, -1)     # bubble border
        curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_WHITE)  # button

        while True:
            try:
                self.tick()
                self.draw()
                key = self.stdscr.getch()
                if key == -1:
                    continue
                self.handle_input(key)
            except KeyboardInterrupt:
                break
            except curses.error:
                pass

    def tick(self):
        buddy = BUDDIES.get(self.current, BUDDIES["cat"])
        frames = buddy.get(self.mood, buddy["idle"])

        # Advance frame
        if self.anim_type == "loop":
            self.frame_idx = (self.frame_idx + 1) % len(frames)
        elif self.anim_type == "oneshot":
            if self.frame_idx < len(frames) - 1:
                self.frame_idx += 1
            else:
                # Oneshot finished — return to idle loop
                self.oneshot_done = True
                self.set_mood("idle", "loop")

        # Subtle horizontal drift (every 3 ticks)
        if self.frame_idx % 3 == 0:
            self.position_offset += self.drift_dir
            if abs(self.position_offset) >= 2:
                self.drift_dir *= -1

        # Check system state periodically
        self.ticks_since_state_check += 1
        if self.ticks_since_state_check >= self.state_check_interval:
            self.ticks_since_state_check = 0
            self._check_state()

        # Decrement speech timer
        if self.message_timer > 0:
            self.message_timer -= 1

        # Random idle behavior
        self.idle_ticks += 1
        if self.last_state == "idle" and self.anim_type == "loop" and self.message_timer <= 0:
            if self.idle_ticks > 60:  # ~36 seconds at 600ms tick
                if self.mood != "sleep":
                    self.set_mood("sleep", "loop")
                if random.random() < 0.2:
                    self.say("long_idle")
            elif random.random() < 0.08:
                self.say("idle")
                m = random.choice(["idle", "happy", "think"])
                self.set_mood(m, "loop")

        # Reload buddy file
        new = load_buddy()
        if new != self.current and new in BUDDIES:
            self.current = new
            self.set_mood("happy", "loop")
            self.message = f"hi! i'm {BUDDIES[new]['name']}!"
            self.message_timer = 6

    def _check_state(self):
        state = detect_state()
        if state == self.last_state:
            return

        self.last_state = state
        self.idle_ticks = 0

        # Check for special reaction animation
        reactions = STATE_REACTION_MAP.get(self.current, {})
        if state in reactions:
            reaction_mood = reactions[state]
            self.set_mood(reaction_mood, "oneshot")
        else:
            # Use default mood mapping
            mood, atype = STATE_MOOD_MAP.get(state, ("idle", "loop"))
            oneshot_moods = BUDDIES.get(self.current, {}).get("oneshot_moods", [])
            if mood in oneshot_moods:
                atype = "oneshot"
            self.set_mood(mood, atype)

        self.say(state)

    def set_mood(self, mood, anim_type="loop"):
        buddy = BUDDIES.get(self.current, BUDDIES["cat"])
        if mood not in buddy:
            mood = "idle"
        self.mood = mood
        self.anim_type = anim_type
        self.frame_idx = 0
        self.oneshot_done = False

    def say(self, category):
        buddy = BUDDIES.get(self.current, BUDDIES["cat"])
        msgs = buddy["messages"].get(category, buddy["messages"]["idle"])
        self.message = random.choice(msgs)
        self.message_timer = 6  # ~3.6 seconds at 600ms tick

    def draw(self):
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()
        buddy = BUDDIES.get(self.current, BUDDIES["cat"])
        frames = buddy.get(self.mood, buddy["idle"])
        frame = frames[self.frame_idx % len(frames)]

        y = 1

        # Name
        name = buddy["name"]
        self.safe_addstr(y, max(0, (w - len(name)) // 2), name, curses.color_pair(4) | curses.A_BOLD)
        y += 2

        # Speech bubble
        if self.message and self.message_timer > 0:
            msg = self.message[:w - 4]
            bubble_w = len(msg) + 4
            bx = max(0, (w - bubble_w) // 2)
            self.safe_addstr(y, bx, "┌" + "─" * (bubble_w - 2) + "┐", curses.color_pair(5))
            y += 1
            self.safe_addstr(y, bx, "│ " + msg + " │", curses.color_pair(2))
            y += 1
            self.safe_addstr(y, bx, "└" + "─" * (bubble_w - 2) + "┘", curses.color_pair(5))
            y += 1
            tail_x = bx + bubble_w // 2
            self.safe_addstr(y, tail_x, "╲", curses.color_pair(5))
            y += 1
        else:
            y += 4

        # ASCII art — centered with drift offset
        for line in frame:
            base_x = max(0, (w - len(line)) // 2)
            x = max(0, min(w - len(line) - 1, base_x + self.position_offset))
            self.safe_addstr(y, x, line, curses.color_pair(1))
            y += 1

        # Switch buttons at bottom
        y = h - 2
        x = 1
        for b in BUDDY_LIST:
            label = f" {b} "
            if b == self.current:
                attr = curses.color_pair(3) | curses.A_BOLD
            else:
                attr = curses.color_pair(6)
            if x + len(label) < w:
                self.safe_addstr(y, x, label, attr)
            x += len(label) + 1

        self.stdscr.refresh()

    def handle_input(self, key):
        if key == curses.KEY_MOUSE:
            try:
                _, mx, my, _, bstate = curses.getmouse()
                h, _ = self.stdscr.getmaxyx()
                if my >= h - 3:
                    x = 1
                    for b in BUDDY_LIST:
                        label = f" {b} "
                        if x <= mx < x + len(label):
                            self.switch_to(b)
                            return
                        x += len(label) + 1
                else:
                    # Pet!
                    buddy = BUDDIES.get(self.current, BUDDIES["cat"])
                    pet_msgs = {
                        "cat": ["*purrs*", "*headbutt*", "mrrp!", "*slow blink*", ":3"],
                        "dog": ["*tail goes crazy*", "*licks hand*", "WOOF!", "*belly up*"],
                        "owl": ["*tolerates it*", "...acceptable", "*ruffles*", "hoo."],
                        "ghost": ["*warm glow*", "*nuzzle?*", "boo! :)", "*flicker*"],
                        "robot": ["*happy beep*", "CONTACT DETECTED", "*vibrate*", "01 <3"],
                    }
                    msgs = pet_msgs.get(self.current, ["*happy*"])
                    self.set_mood("happy", "loop")
                    self.message = random.choice(msgs)
                    self.message_timer = 5
            except curses.error:
                pass
            return

        if key == ord("q"):
            print("\033[?1003l", end="", flush=True)
            sys.exit(0)
        elif key in (ord(" "), ord("\n")):
            self.set_mood("happy", "loop")
            self.say("idle")
        elif key == ord("\t"):
            idx = BUDDY_LIST.index(self.current) if self.current in BUDDY_LIST else 0
            self.switch_to(BUDDY_LIST[(idx + 1) % len(BUDDY_LIST)])
        elif ord("1") <= key <= ord("9"):
            idx = key - ord("1")
            if idx < len(BUDDY_LIST):
                self.switch_to(BUDDY_LIST[idx])

    def switch_to(self, name):
        if name in BUDDIES:
            self.current = name
            save_buddy(name)
            self.set_mood("happy", "loop")
            self.message = f"hi! i'm {BUDDIES[name]['name']}!"
            self.message_timer = 6

    def safe_addstr(self, y, x, text, attr=curses.A_NORMAL):
        h, w = self.stdscr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return
        try:
            self.stdscr.addnstr(y, x, text, w - x - 1, attr)
        except curses.error:
            pass


def main(stdscr):
    widget = BuddyWidget(stdscr)
    widget.run()


if __name__ == "__main__":
    curses.wrapper(main)
