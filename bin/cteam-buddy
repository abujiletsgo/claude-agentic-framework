#!/usr/bin/env python3
"""cteam-buddy — Animated companion widget for the cteam dashboard."""
import curses
import json
import os
import random
import sys
import time
from pathlib import Path

# Add lib/ to path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from buddies import BUDDIES, BUDDY_LIST

CAF_DIR = Path.home() / "Documents" / "caf-team"
BUDDY_FILE = CAF_DIR / ".claude" / "buddy.json"
SPRINT_DIR = Path("/tmp/caf_sprint")


def load_buddy():
    try:
        data = json.loads(BUDDY_FILE.read_text())
        return data.get("active", "cat")
    except Exception:
        return "cat"


def save_buddy(name):
    BUDDY_FILE.parent.mkdir(parents=True, exist_ok=True)
    BUDDY_FILE.write_text(json.dumps({"active": name}) + "\n")


def detect_state():
    """Detect current system state for buddy mood."""
    # Check for active sprints
    if SPRINT_DIR.is_dir():
        for d in SPRINT_DIR.iterdir():
            status_file = d / "status.json"
            if status_file.exists():
                try:
                    data = json.loads(status_file.read_text())
                    states = [
                        v.get("status", "") if isinstance(v, dict) else ""
                        for v in data.values()
                    ]
                    if any(s == "failed" for s in states):
                        return "sprint_fail"
                    if any(s == "running" for s in states):
                        return "build"
                    if all(s == "done" for s in states if s):
                        return "sprint_done"
                    return "sprint_start"
                except Exception:
                    pass
    return "idle"


class BuddyWidget:
    def __init__(self, stdscr):
        self.stdscr = stdscr
        self.current = load_buddy()
        self.mood = "idle"
        self.message = ""
        self.message_timer = 0
        self.idle_ticks = 0
        self.last_state = "idle"
        self.speech_bubble = True

    def run(self):
        curses.curs_set(0)
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        self.stdscr.timeout(3000)  # tick every 3s

        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_YELLOW, -1)
        curses.init_pair(3, curses.COLOR_GREEN, -1)
        curses.init_pair(4, curses.COLOR_MAGENTA, -1)
        curses.init_pair(5, curses.COLOR_WHITE, -1)
        curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_WHITE)  # button

        while True:
            try:
                self.tick()
                self.draw()
                key = self.stdscr.getch()
                if key == -1:
                    continue
                self.handle_input(key)
            except KeyboardInterrupt:
                break
            except curses.error:
                pass

    def tick(self):
        state = detect_state()

        # State changed?
        if state != self.last_state:
            self.last_state = state
            self.idle_ticks = 0
            self.say(state)
            if "sprint" in state or state == "build":
                self.mood = "alert" if "fail" in state else "happy"
            else:
                self.mood = "idle"
        else:
            self.idle_ticks += 1

        # Random idle chatter
        if state == "idle" and self.message_timer <= 0:
            if self.idle_ticks > 20:
                # Long idle — sleepy
                self.mood = "sleep"
                if random.random() < 0.3:
                    self.say("long_idle")
            elif random.random() < 0.15:
                self.say("idle")
                moods = ["idle", "happy", "think"]
                self.mood = random.choice(moods)

        if self.message_timer > 0:
            self.message_timer -= 1

        # Reload buddy choice (in case switched via /buddy)
        new = load_buddy()
        if new != self.current and new in BUDDIES:
            self.current = new
            self.mood = "happy"
            self.message = f"hi! i'm {BUDDIES[new]['name']}!"
            self.message_timer = 3

    def say(self, category):
        buddy = BUDDIES.get(self.current, BUDDIES["cat"])
        msgs = buddy["messages"].get(category, buddy["messages"]["idle"])
        self.message = random.choice(msgs)
        self.message_timer = 4

    def draw(self):
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()
        buddy = BUDDIES.get(self.current, BUDDIES["cat"])
        art = buddy.get(self.mood, buddy["idle"])

        y = 1

        # Name
        name = buddy["name"]
        self.safe_addstr(y, max(0, (w - len(name)) // 2), name, curses.color_pair(4) | curses.A_BOLD)
        y += 2

        # Speech bubble
        if self.message and self.message_timer > 0:
            msg = self.message[:w - 4]
            bubble_w = len(msg) + 4
            bx = max(0, (w - bubble_w) // 2)
            self.safe_addstr(y, bx, "┌" + "─" * (bubble_w - 2) + "┐", curses.color_pair(5))
            y += 1
            self.safe_addstr(y, bx, "│ " + msg + " │", curses.color_pair(2))
            y += 1
            # Tail centered
            tail_x = bx + bubble_w // 2
            self.safe_addstr(y, bx, "└" + "─" * (bubble_w - 2) + "┘", curses.color_pair(5))
            y += 1
            self.safe_addstr(y, tail_x, "╲", curses.color_pair(5))
            y += 1
        else:
            y += 4  # reserve space

        # ASCII art (centered)
        for line in art:
            x = max(0, (w - len(line)) // 2)
            self.safe_addstr(y, x, line, curses.color_pair(1))
            y += 1

        # Switch buttons at bottom
        y = h - 2
        x = 1
        for b in BUDDY_LIST:
            label = f" {b} "
            if b == self.current:
                attr = curses.color_pair(3) | curses.A_BOLD
            else:
                attr = curses.color_pair(6)
            self.safe_addstr(y, x, label, attr)
            x += len(label) + 1

        self.stdscr.refresh()

    def handle_input(self, key):
        if key == curses.KEY_MOUSE:
            try:
                _, mx, my, _, bstate = curses.getmouse()
                h, _ = self.stdscr.getmaxyx()
                if my >= h - 3:
                    # Click on buddy buttons
                    x = 1
                    for b in BUDDY_LIST:
                        label = f" {b} "
                        if x <= mx < x + len(label):
                            self.switch_to(b)
                            return
                        x += len(label) + 1
                else:
                    # Click on buddy — pet it
                    self.mood = "happy"
                    self.message = random.choice(["*purrs*", "*happy*", "hey!", ":3", "*nuzzle*"])
                    self.message_timer = 3
            except curses.error:
                pass
            return

        # Keyboard shortcuts
        if key == ord("q"):
            sys.exit(0)
        elif key == ord(" ") or key == ord("\n"):
            # Pet the buddy
            self.mood = "happy"
            buddy = BUDDIES.get(self.current, BUDDIES["cat"])
            self.message = random.choice(buddy["messages"]["idle"])
            self.message_timer = 3
        elif key == ord("\t"):
            # Cycle to next buddy
            idx = BUDDY_LIST.index(self.current) if self.current in BUDDY_LIST else 0
            next_idx = (idx + 1) % len(BUDDY_LIST)
            self.switch_to(BUDDY_LIST[next_idx])
        elif ord("1") <= key <= ord("9"):
            idx = key - ord("1")
            if idx < len(BUDDY_LIST):
                self.switch_to(BUDDY_LIST[idx])

    def switch_to(self, name):
        if name in BUDDIES:
            self.current = name
            save_buddy(name)
            self.mood = "happy"
            self.message = f"hi! i'm {BUDDIES[name]['name']}!"
            self.message_timer = 4

    def safe_addstr(self, y, x, text, attr=curses.A_NORMAL):
        h, w = self.stdscr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return
        try:
            self.stdscr.addnstr(y, x, text, w - x - 1, attr)
        except curses.error:
            pass


def main(stdscr):
    widget = BuddyWidget(stdscr)
    widget.run()


if __name__ == "__main__":
    curses.wrapper(main)
