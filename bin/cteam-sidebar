#!/usr/bin/env bash
# cteam-sidebar — Interactive session/project manager panel
set -euo pipefail

CAF_DIR="${HOME}/Documents/caf-team"
SESSIONS_FILE="${CAF_DIR}/.claude/sessions.json"
PROJECTS_FILE="${CAF_DIR}/.claude/projects.json"

# Ensure files exist
mkdir -p "$(dirname "$SESSIONS_FILE")"
[[ -f "$SESSIONS_FILE" ]] || printf '{}\n' > "$SESSIONS_FILE"
[[ -f "$PROJECTS_FILE" ]] || cat > "$PROJECTS_FILE" <<'EOF'
[
  {"key": "1", "name": "caf-team", "path": "~/Documents/caf-team"},
  {"key": "2", "name": "caf (upstream)", "path": "~/Documents/claude-agentic-framework"},
  {"key": "3", "name": "gstack", "path": "~/Documents/caf-team/global-skills/gstack"}
]
EOF

_expand() { eval echo "$1"; }

_refresh() {
  clear
  printf '\033[1m  CAF Sessions\033[0m\n'
  printf '  ─────────────────────────\n'

  tmux list-windows -F '#{window_index}|#{window_name}|#{window_active}|#{pane_current_command}' 2>/dev/null | while IFS='|' read -r idx name active cmd; do
    local marker=" "
    [[ "$active" == "1" ]] && marker=">"

    # Look up custom label + project
    local info
    info="$(python3 -c "
import json
try:
    d = json.load(open('$SESSIONS_FILE'))
    e = d.get(str($idx), {})
    if isinstance(e, str): print(e + '||')  # legacy: just a name
    else: print(e.get('name','') + '|' + e.get('project','') + '|')
except: print('||')
" 2>/dev/null)" || info="||"

    local label project
    label="$(echo "$info" | cut -d'|' -f1)"
    project="$(echo "$info" | cut -d'|' -f2)"

    if [[ -n "$label" ]]; then
      if [[ -n "$project" ]]; then
        printf '  %s \033[36m%s\033[0m  \033[1m%s\033[0m \033[2m[%s]\033[0m\n' "$marker" "$idx" "$label" "$project"
      else
        printf '  %s \033[36m%s\033[0m  \033[1m%s\033[0m \033[2m(%s)\033[0m\n' "$marker" "$idx" "$label" "$cmd"
      fi
    else
      printf '  %s \033[36m%s\033[0m  %s \033[2m(%s)\033[0m\n' "$marker" "$idx" "$name" "$cmd"
    fi
  done

  printf '\n  ─────────────────────────\n'
  printf '  \033[2m[n]ew session  [r]ename\033[0m\n'
  printf '  \033[2m[d]elete      [p]rojects\033[0m\n'
  printf '  \033[2m[0-9] switch  [q]uit\033[0m\n'
  printf '  ─────────────────────────\n'

  # Sprint status
  local sprint_dir="/tmp/caf_sprint"
  if [[ -d "$sprint_dir" ]]; then
    local found=0
    local sprint_id
    for sprint_id in "$sprint_dir"/*/; do
      [[ -f "${sprint_id}status.json" ]] || continue
      found=1
      local sid
      sid="$(basename "$sprint_id")"
      printf '\n  \033[33m⚡ Sprint: %s\033[0m\n' "$sid"
      python3 -c "
import json
try:
    d = json.load(open('${sprint_id}status.json'))
    for role, info in d.items():
        st = info.get('status', '?')
        sym = {'running':'●','done':'✓','failed':'✗'}.get(st, '○')
        print(f'    {sym} {role}: {st}')
except: pass
" 2>/dev/null || true
    done
    (( found )) || true
  fi
}

_pick_project() {
  printf '\n  \033[1mSelect project:\033[0m\n'
  python3 -c "
import json
try:
    projects = json.load(open('$PROJECTS_FILE'))
    for p in projects:
        print(f\"  [{p['key']}] {p['name']}  \033[2m{p['path']}\033[0m\")
except: pass
" 2>/dev/null || true
  printf '  [c] custom path\n'
  printf '  > '
  read -rsn1 choice

  if [[ "$choice" == "c" ]]; then
    printf '\n  Path: '
    read -r custom_path
    _expand "$custom_path"
    return
  fi

  # Look up project by key
  local path
  path="$(python3 -c "
import json
try:
    projects = json.load(open('$PROJECTS_FILE'))
    for p in projects:
        if p['key'] == '$choice':
            print(p['path'])
            break
except: pass
" 2>/dev/null)" || path=""

  if [[ -n "$path" ]]; then
    _expand "$path"
  else
    echo "$CAF_DIR"
  fi
}

_save_session() {
  local idx="$1" name="$2" project="${3:-}"
  python3 -c "
import json
f = '$SESSIONS_FILE'
try: d = json.load(open(f))
except: d = {}
d[str($idx)] = {'name': '$name', 'project': '$project'}
json.dump(d, open(f, 'w'), indent=2)
" 2>/dev/null || true
}

_new_window() {
  printf '  Session name: '
  read -r label

  local project_path project_name
  project_path="$(_pick_project)"
  project_name="$(basename "$project_path")"

  [[ -d "$project_path" ]] || { printf '  \033[31mPath not found: %s\033[0m\n' "$project_path"; sleep 1; return; }

  local idx
  idx="$(tmux new-window -t caf-team -c "$project_path" -P -F '#{window_index}')"

  local display_name="${label:-$project_name}"
  tmux rename-window -t "caf-team:${idx}" "$display_name"
  _save_session "$idx" "$display_name" "$project_name"

  # Auto-launch claude in the new window
  tmux send-keys -t "caf-team:${idx}" "claude" Enter
}

_rename_window() {
  printf '  Window #: '
  read -r idx
  printf '  New name: '
  read -r label
  if [[ -n "$idx" && -n "$label" ]]; then
    tmux rename-window -t "caf-team:${idx}" "$label" 2>/dev/null || true
    # Preserve project info
    local project
    project="$(python3 -c "
import json
try:
    d = json.load(open('$SESSIONS_FILE'))
    e = d.get(str($idx), {})
    print(e.get('project','') if isinstance(e, dict) else '')
except: print('')
" 2>/dev/null)" || project=""
    _save_session "$idx" "$label" "$project"
  fi
}

_del_window() {
  printf '  Window # to close: '
  read -r idx
  if [[ -n "$idx" ]]; then
    tmux kill-window -t "caf-team:${idx}" 2>/dev/null || printf '  (not found)\n'
    python3 -c "
import json
f = '$SESSIONS_FILE'
try: d = json.load(open(f))
except: d = {}
d.pop(str($idx), None)
json.dump(d, open(f, 'w'), indent=2)
" 2>/dev/null || true
  fi
}

_manage_projects() {
  printf '\n  \033[1mProjects:\033[0m\n'
  python3 -c "
import json
try:
    projects = json.load(open('$PROJECTS_FILE'))
    for p in projects:
        print(f\"  [{p['key']}] {p['name']}  \033[2m{p['path']}\033[0m\")
except: pass
" 2>/dev/null || true
  printf '\n  [a]dd  [b]ack\n  > '
  read -rsn1 choice
  if [[ "$choice" == "a" ]]; then
    printf '\n  Name: '
    read -r pname
    printf '  Path: '
    read -r ppath
    printf '  Key (single char): '
    read -rsn1 pkey
    python3 -c "
import json
f = '$PROJECTS_FILE'
try: projects = json.load(open(f))
except: projects = []
projects.append({'key': '$pkey', 'name': '$pname', 'path': '$ppath'})
json.dump(projects, open(f, 'w'), indent=2)
" 2>/dev/null || true
    printf '\n  Added.\n'
    sleep 0.5
  fi
}

# Main loop
while true; do
  _refresh
  printf '\n  > '
  read -rsn1 key
  case "$key" in
    n) _new_window ;;
    r) _rename_window ;;
    d) _del_window ;;
    p) _manage_projects ;;
    q) exit 0 ;;
    [0-9]) tmux select-window -t "caf-team:${key}" 2>/dev/null || true ;;
    *) ;; # refresh
  esac
done
