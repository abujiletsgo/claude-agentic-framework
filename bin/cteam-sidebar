#!/usr/bin/env python3
"""cteam-sidebar — Clickable session/project manager panel for tmux."""
import curses
import json
import os
import subprocess
import sys
from pathlib import Path

CAF_DIR = Path.home() / "Documents" / "caf-team"
SESSIONS_FILE = CAF_DIR / ".claude" / "sessions.json"
PROJECTS_FILE = CAF_DIR / ".claude" / "projects.json"
SPRINT_DIR = Path("/tmp/caf_sprint")

DEFAULT_PROJECTS = [
    {"key": "1", "name": "caf-team", "path": "~/Documents/caf-team"},
    {"key": "2", "name": "caf (upstream)", "path": "~/Documents/claude-agentic-framework"},
    {"key": "3", "name": "gstack", "path": "~/Documents/caf-team/global-skills/gstack"},
]


def ensure_files():
    SESSIONS_FILE.parent.mkdir(parents=True, exist_ok=True)
    if not SESSIONS_FILE.exists():
        SESSIONS_FILE.write_text("{}\n")
    if not PROJECTS_FILE.exists():
        PROJECTS_FILE.write_text(json.dumps(DEFAULT_PROJECTS, indent=2) + "\n")


def load_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default if default is not None else {}


def save_json(path, data):
    path.write_text(json.dumps(data, indent=2) + "\n")


def tmux(*args):
    try:
        return subprocess.run(
            ["tmux", *args], capture_output=True, text=True, timeout=3
        ).stdout.strip()
    except Exception:
        return ""


def get_windows():
    raw = tmux("list-windows", "-F", "#{window_index}|#{window_name}|#{window_active}|#{pane_current_command}")
    if not raw:
        return []
    windows = []
    sessions = load_json(SESSIONS_FILE, {})
    for line in raw.splitlines():
        parts = line.split("|", 3)
        if len(parts) < 4:
            continue
        idx, name, active, cmd = parts
        info = sessions.get(idx, {})
        if isinstance(info, str):
            info = {"name": info, "project": ""}
        windows.append({
            "idx": idx,
            "name": info.get("name") or name,
            "project": info.get("project", ""),
            "active": active == "1",
            "cmd": cmd,
        })
    return windows


def get_sprints():
    sprints = []
    if not SPRINT_DIR.is_dir():
        return sprints
    for d in SPRINT_DIR.iterdir():
        status_file = d / "status.json"
        if status_file.exists():
            try:
                data = json.loads(status_file.read_text())
                sprints.append({"id": d.name, "leads": data})
            except Exception:
                pass
    return sprints


def expand_path(p):
    return str(Path(os.path.expanduser(p)).resolve())


class Sidebar:
    def __init__(self, stdscr):
        self.stdscr = stdscr
        self.selected = 0
        self.mode = "main"  # main, new_session, projects, rename
        self.input_buf = ""
        self.input_label = ""
        self.input_callback = None
        self.new_session_name = ""
        self.new_session_project = ""
        self.message = ""
        self.message_timer = 0

    def run(self):
        curses.curs_set(0)
        curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
        curses.mouseinterval(0)
        self.stdscr.timeout(2000)  # refresh every 2s
        # Enable mouse tracking
        print("\033[?1003h", end="", flush=True)

        # Colors
        curses.start_color()
        curses.use_default_colors()
        # All pairs use terminal defaults — theme comes from Ghostty/terminal
        curses.init_pair(1, -1, -1)  # default
        curses.init_pair(2, -1, -1)  # selected (use A_BOLD + A_REVERSE)
        curses.init_pair(3, -1, -1)  # sprint status (use A_BOLD)
        curses.init_pair(4, -1, -1)  # done (use A_DIM)
        curses.init_pair(5, -1, -1)  # failed (use A_BOLD)
        curses.init_pair(6, -1, -1)  # button
        curses.init_pair(7, -1, -1)  # active
        curses.init_pair(8, -1, -1)  # hover

        while True:
            try:
                self.draw()
                key = self.stdscr.getch()
                if key == -1:
                    continue
                self.handle_input(key)
            except KeyboardInterrupt:
                break
            except curses.error:
                pass

    def draw(self):
        self.stdscr.erase()
        h, w = self.stdscr.getmaxyx()
        self.clickable = []  # (y, x_start, x_end, action, data)

        if self.mode == "main":
            self.draw_main(h, w)
        elif self.mode == "projects":
            self.draw_projects(h, w)
        elif self.mode == "input":
            self.draw_input(h, w)

        self.stdscr.refresh()

    def draw_main(self, h, w):
        y = 0
        # Header
        self.safe_addstr(y, 1, " Sessions ", curses.A_BOLD | curses.A_UNDERLINE)
        y += 2

        windows = get_windows()
        for i, win in enumerate(windows):
            if y >= h - 10:
                break
            marker = "▸" if win["active"] else " "
            attr = curses.A_BOLD | curses.A_REVERSE if i == self.selected else curses.A_NORMAL

            label = f" {marker} {win['idx']}  {win['name']}"
            if win["project"]:
                label += f"  [{win['project']}]"

            self.safe_addstr(y, 0, label.ljust(w), attr)
            self.clickable.append((y, 0, w, "select_window", {"index": i, "win_idx": win["idx"]}))
            y += 1

        # Buttons
        y += 1
        buttons = [
            (" + New ", "new"),
            (" Rename ", "rename"),
            (" Delete ", "delete"),
            (" Projects ", "projects"),
        ]
        x = 1
        for label, action in buttons:
            if x + len(label) + 1 >= w:
                y += 1
                x = 1
            self.safe_addstr(y, x, label, curses.A_DIM)
            self.clickable.append((y, x, x + len(label), "button", action))
            x += len(label) + 1

        # Sprint status
        y += 2
        sprints = get_sprints()
        if sprints:
            self.safe_addstr(y, 1, "⚡ Sprints", curses.A_BOLD)
            y += 1
            for sprint in sprints:
                if y >= h - 2:
                    break
                self.safe_addstr(y, 1, f"  {sprint['id']}", curses.A_BOLD)
                y += 1
                for role, info in sprint["leads"].items():
                    if y >= h - 2:
                        break
                    st = info.get("status", "?") if isinstance(info, dict) else "?"
                    sym = {"running": "●", "done": "✓", "failed": "✗"}.get(st, "○")
                    color = {
                        "done": curses.A_DIM,
                        "failed": curses.A_BOLD,
                        "running": curses.A_BOLD,
                    }.get(st, curses.A_DIM)
                    self.safe_addstr(y, 3, f"{sym} {role}: {st}", color)
                    y += 1

        # Message
        if self.message and self.message_timer > 0:
            self.safe_addstr(h - 1, 1, self.message[:w-2], curses.A_DIM)
            self.message_timer -= 1

    def draw_projects(self, h, w):
        y = 0
        self.safe_addstr(y, 1, " Projects ", curses.A_BOLD | curses.A_UNDERLINE)
        y += 2

        projects = load_json(PROJECTS_FILE, DEFAULT_PROJECTS)
        for i, p in enumerate(projects):
            if y >= h - 4:
                break
            attr = curses.A_BOLD | curses.A_REVERSE if i == self.selected else curses.A_NORMAL
            label = f"  [{p['key']}] {p['name']}"
            self.safe_addstr(y, 0, label.ljust(w), attr)
            y += 1
            self.safe_addstr(y, 4, p["path"][:w-5], curses.A_DIM)
            self.clickable.append((y-1, 0, w, "pick_project", {"index": i}))
            y += 1

        y += 1
        self.safe_addstr(y, 1, " + Add ", curses.A_DIM)
        self.clickable.append((y, 1, 8, "button", "add_project"))
        self.safe_addstr(y, 10, " ← Back ", curses.A_DIM)
        self.clickable.append((y, 10, 18, "button", "back"))

    def draw_input(self, h, w):
        y = h // 3
        self.safe_addstr(y, 1, self.input_label, curses.A_BOLD)
        y += 2
        curses.curs_set(1)
        self.safe_addstr(y, 1, "> " + self.input_buf + "█", curses.A_NORMAL)

    def handle_input(self, key):
        if key == curses.KEY_MOUSE:
            try:
                _, mx, my, _, bstate = curses.getmouse()
                for cy, x1, x2, action, data in self.clickable:
                    if my == cy and x1 <= mx < x2:
                        self.handle_click(action, data)
                        return
            except curses.error:
                pass
            return

        if self.mode == "input":
            self.handle_text_input(key)
            return

        if self.mode == "main":
            windows = get_windows()
            if key == curses.KEY_UP or key == ord("k"):
                self.selected = max(0, self.selected - 1)
            elif key == curses.KEY_DOWN or key == ord("j"):
                self.selected = min(len(windows) - 1, self.selected + 1)
            elif key == ord("\n") or key == ord(" "):
                if 0 <= self.selected < len(windows):
                    tmux("select-window", "-t", f"caf-team:{windows[self.selected]['idx']}")
            elif key == ord("n"):
                self.start_new_session()
            elif key == ord("r"):
                self.start_rename()
            elif key == ord("d"):
                self.delete_selected(windows)
            elif key == ord("p"):
                self.mode = "projects"
                self.selected = 0
            elif key == ord("q"):
                print("\033[?1003l", end="", flush=True)
                sys.exit(0)
            elif ord("0") <= key <= ord("9"):
                tmux("select-window", "-t", f"caf-team:{chr(key)}")

        elif self.mode == "projects":
            projects = load_json(PROJECTS_FILE, DEFAULT_PROJECTS)
            if key == curses.KEY_UP or key == ord("k"):
                self.selected = max(0, self.selected - 1)
            elif key == curses.KEY_DOWN or key == ord("j"):
                self.selected = min(len(projects) - 1, self.selected + 1)
            elif key == ord("\n"):
                if 0 <= self.selected < len(projects):
                    self.finish_project_pick(projects[self.selected])
            elif key == 27 or key == ord("b"):  # ESC or b for back
                self.mode = "main"
                self.selected = 0

    def handle_text_input(self, key):
        if key == 27:  # ESC
            curses.curs_set(0)
            self.mode = "main"
        elif key in (curses.KEY_BACKSPACE, 127, 8):
            self.input_buf = self.input_buf[:-1]
        elif key == ord("\n"):
            curses.curs_set(0)
            if self.input_callback:
                self.input_callback(self.input_buf)
            self.mode = "main"
        elif 32 <= key < 127:
            self.input_buf += chr(key)

    def handle_click(self, action, data):
        if action == "select_window":
            self.selected = data["index"]
            tmux("select-window", "-t", f"caf-team:{data['win_idx']}")
        elif action == "button":
            if data == "new":
                self.start_new_session()
            elif data == "rename":
                self.start_rename()
            elif data == "delete":
                self.delete_selected(get_windows())
            elif data == "projects":
                self.mode = "projects"
                self.selected = 0
            elif data == "back":
                self.mode = "main"
                self.selected = 0
            elif data == "add_project":
                self.start_add_project()
        elif action == "pick_project":
            projects = load_json(PROJECTS_FILE, DEFAULT_PROJECTS)
            idx = data["index"]
            if 0 <= idx < len(projects):
                self.finish_project_pick(projects[idx])

    def start_new_session(self):
        self.mode = "input"
        self.input_buf = ""
        self.input_label = "Session name:"
        self.input_callback = self._after_session_name

    def _after_session_name(self, name):
        self.new_session_name = name
        self.mode = "projects"
        self.selected = 0

    def finish_project_pick(self, project):
        name = self.new_session_name or project["name"]
        path = expand_path(project["path"])
        if not os.path.isdir(path):
            self.message = f"Path not found: {path}"
            self.message_timer = 3
            self.mode = "main"
            return

        result = tmux("new-window", "-t", "caf-team", "-c", path, "-P", "-F", "#{window_index}")
        if result:
            tmux("rename-window", "-t", f"caf-team:{result}", name)
            sessions = load_json(SESSIONS_FILE, {})
            sessions[result] = {"name": name, "project": project["name"]}
            save_json(SESSIONS_FILE, sessions)
            tmux("send-keys", "-t", f"caf-team:{result}", "claude", "Enter")

        self.new_session_name = ""
        self.mode = "main"
        self.selected = 0

    def start_rename(self):
        self.mode = "input"
        self.input_buf = ""
        self.input_label = "New name:"
        self.input_callback = self._do_rename

    def _do_rename(self, name):
        windows = get_windows()
        if 0 <= self.selected < len(windows):
            win = windows[self.selected]
            tmux("rename-window", "-t", f"caf-team:{win['idx']}", name)
            sessions = load_json(SESSIONS_FILE, {})
            old = sessions.get(win["idx"], {})
            project = old.get("project", "") if isinstance(old, dict) else ""
            sessions[win["idx"]] = {"name": name, "project": project}
            save_json(SESSIONS_FILE, sessions)

    def delete_selected(self, windows):
        if 0 <= self.selected < len(windows):
            win = windows[self.selected]
            tmux("kill-window", "-t", f"caf-team:{win['idx']}")
            sessions = load_json(SESSIONS_FILE, {})
            sessions.pop(win["idx"], None)
            save_json(SESSIONS_FILE, sessions)
            self.selected = max(0, self.selected - 1)

    def start_add_project(self):
        self.mode = "input"
        self.input_buf = ""
        self.input_label = "Project name:"
        self.input_callback = self._after_project_name

    def _after_project_name(self, name):
        self._add_project_name = name
        self.mode = "input"
        self.input_buf = ""
        self.input_label = "Path:"
        self.input_callback = self._after_project_path

    def _after_project_path(self, path):
        projects = load_json(PROJECTS_FILE, DEFAULT_PROJECTS)
        key = str(len(projects) + 1)
        projects.append({"key": key, "name": self._add_project_name, "path": path})
        save_json(PROJECTS_FILE, projects)
        self.mode = "projects"

    def safe_addstr(self, y, x, text, attr=curses.A_NORMAL):
        h, w = self.stdscr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return
        try:
            self.stdscr.addnstr(y, x, text, w - x - 1, attr)
        except curses.error:
            pass


def main(stdscr):
    ensure_files()
    sidebar = Sidebar(stdscr)
    sidebar.run()


if __name__ == "__main__":
    curses.wrapper(main)
