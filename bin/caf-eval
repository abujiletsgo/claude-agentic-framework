#!/usr/bin/env python3
"""caf-eval: Compare multi-lead orchestration run against single-agent run."""

import argparse
import json
import math
import re
import sys
from pathlib import Path


def get_wall_clock_multi(orch_dir: Path):
    """Compute wall clock time for multi-lead run in seconds."""
    try:
        # Earliest mtime of any file in orch_dir as start
        all_files = list(orch_dir.rglob("*"))
        all_files = [f for f in all_files if f.is_file()]
        if not all_files:
            return None
        start_mtime = min(f.stat().st_mtime for f in all_files)

        # Latest mtime of any *.status file as end
        status_files = list(orch_dir.rglob("*.status"))
        if not status_files:
            return None
        end_mtime = max(f.stat().st_mtime for f in status_files)

        return end_mtime - start_mtime
    except Exception:
        return None


def get_wall_clock_single(orch_dir: Path):
    """Compute wall clock time for single-agent run in seconds."""
    from datetime import datetime

    def parse_iso(s):
        return datetime.fromisoformat(s.replace("Z", "+00:00"))

    # Try v2 filenames first, then fall back to original names
    for start_name, end_name in [
        ("single-agent-v2-start.json", "single-agent-v2-end.json"),
        ("single-agent-start.json", "single-agent-end.json"),
    ]:
        try:
            start_file = orch_dir / start_name
            end_file = orch_dir / end_name
            if not start_file.exists() or not end_file.exists():
                continue
            start_data = json.loads(start_file.read_text())
            end_data = json.loads(end_file.read_text())
            # Accept either "start"/"end" or "timestamp" keys
            start_val = start_data.get("start") or start_data.get("timestamp")
            end_val = end_data.get("end") or end_data.get("timestamp")
            if start_val and end_val:
                return (parse_iso(end_val) - parse_iso(start_val)).total_seconds()
        except Exception:
            continue
    return None


def get_token_estimate(result_files):
    """Sum word counts of all .md files, multiply by 1.3, round up."""
    try:
        total_words = sum(len(f.read_text(errors="replace").split()) for f in result_files if f.is_file())
        return math.ceil(total_words * 1.3)
    except Exception:
        return None


def extract_quality_score(path: Path):
    """Parse quality score from a markdown file. Returns (value, max) or None."""
    if not path or not path.exists():
        return None
    try:
        text = path.read_text(errors="replace")
        # Try "Score: 78" or "78/100"
        m = re.search(r"Score:\s*(\d+)", text)
        if m:
            return (int(m.group(1)), 100)
        m = re.search(r"(\d+)/100", text)
        if m:
            return (int(m.group(1)), 100)
        return None
    except Exception:
        return None


def format_time(seconds):
    if seconds is None:
        return "N/A"
    return str(int(round(seconds)))


def format_tokens(tokens):
    if tokens is None:
        return "N/A"
    return f"{tokens:,}"


def format_score(score_tuple):
    if score_tuple is None:
        return "N/A"
    return f"{score_tuple[0]}/{score_tuple[1]}"


def winner_lower(a, b):
    """Lower is better. Returns 'Multi-Lead', 'Single-Agent', or 'Tie'."""
    if a is None and b is None:
        return "N/A"
    if a is None:
        return "Single-Agent"
    if b is None:
        return "Multi-Lead"
    if abs(a - b) / max(abs(a), abs(b), 1) <= 0.05:
        return "Tie"
    return "Multi-Lead" if a < b else "Single-Agent"


def winner_higher(a_tuple, b_tuple):
    """Higher is better (quality). Returns 'Multi-Lead', 'Single-Agent', or 'Tie'."""
    if a_tuple is None and b_tuple is None:
        return "N/A"
    if a_tuple is None:
        return "Single-Agent"
    if b_tuple is None:
        return "Multi-Lead"
    a = a_tuple[0]
    b = b_tuple[0]
    if abs(a - b) / max(abs(a), abs(b), 1) <= 0.05:
        return "Tie"
    return "Multi-Lead" if a > b else "Single-Agent"


def main():
    parser = argparse.ArgumentParser(
        description="Compare multi-lead orchestration run against single-agent run."
    )
    parser.add_argument("--orch-id", required=True, help="Orchestration run ID (e.g. orch_1776061877)")
    parser.add_argument(
        "--single-dir",
        default=None,
        help="Path to single-agent output directory (default: same orch dir)",
    )
    args = parser.parse_args()

    orch_base = Path("/tmp/caf_orch")
    orch_dir = orch_base / args.orch_id

    if not orch_dir.exists():
        print(f"Error: orch directory not found: {orch_dir}", file=sys.stderr)
        sys.exit(1)

    # --- Wall Clock ---
    multi_time = get_wall_clock_multi(orch_dir)
    single_time = get_wall_clock_single(orch_dir)

    # --- Token Estimate ---
    multi_results_dir = orch_dir / "results"
    multi_result_files = list(multi_results_dir.glob("*.md")) if multi_results_dir.exists() else []
    # Exclude single-agent files from multi-lead token count
    multi_result_files = [f for f in multi_result_files if "single-agent" not in f.name]
    multi_tokens = get_token_estimate(multi_result_files) if multi_result_files else None

    # Try v2 result first, fall back to original
    single_result_file = orch_dir / "results" / "single-agent-v2-result.md"
    if not single_result_file.exists():
        single_result_file = orch_dir / "results" / "single-agent-result.md"
    single_tokens = get_token_estimate([single_result_file]) if single_result_file.exists() else None

    # --- Quality Score ---
    eval_report = orch_dir / "evaluation_report.md"
    if not eval_report.exists():
        eval_report = orch_dir / "results" / "evaluation_report.md"
    multi_score = extract_quality_score(eval_report)

    # Try v2 eval first, then original eval, then result file
    single_eval = orch_dir / "results" / "single-agent-v2-eval.md"
    if not single_eval.exists():
        single_eval = orch_dir / "results" / "single-agent-eval.md"
    if single_eval.exists():
        single_score = extract_quality_score(single_eval)
    else:
        single_score = extract_quality_score(single_result_file)

    # --- Winners ---
    time_winner = winner_lower(multi_time, single_time)
    tokens_winner = winner_lower(multi_tokens, single_tokens)
    quality_winner = winner_higher(multi_score, single_score)

    # --- Count wins ---
    multi_wins = sum(1 for w in [time_winner, tokens_winner, quality_winner] if w == "Multi-Lead")
    single_wins = sum(1 for w in [time_winner, tokens_winner, quality_winner] if w == "Single-Agent")

    # --- Output ---
    print(f"# CAF Multi-Lead vs Single-Agent Comparison")
    print(f"## {args.orch_id}")
    print()
    print(f"| {'Metric':<18} | {'Multi-Lead':<14} | {'Single-Agent':<14} | {'Winner':<12} |")
    print(f"|{'-'*20}|{'-'*16}|{'-'*16}|{'-'*14}|")
    print(
        f"| {'Wall Clock (sec)':<18} | {format_time(multi_time):<14} | {format_time(single_time):<14} | {time_winner:<12} |"
    )
    print(
        f"| {'Token Estimate':<18} | {format_tokens(multi_tokens):<14} | {format_tokens(single_tokens):<14} | {tokens_winner:<12} |"
    )
    print(
        f"| {'Quality Score':<18} | {format_score(multi_score):<14} | {format_score(single_score):<14} | {quality_winner:<12} |"
    )
    print()
    print(f"## Verdict")
    if multi_wins > single_wins:
        print(f"Multi-Lead won {multi_wins}/3 metrics.")
    elif single_wins > multi_wins:
        print(f"Single-Agent won {single_wins}/3 metrics.")
    else:
        print(f"Tied at {multi_wins}/3 metrics each.")


if __name__ == "__main__":
    main()
