#!/usr/bin/env bash
# cdash — Open CAF dashboard + report panels in the current cmux tab.
# Does NOT launch Claude. Run this from inside an existing session.
#
# Layout:  [current pane]  │  [dashboard: sprint_report.py]  │  [report: activity_report.py]
set -euo pipefail

CAF_DIR="$(cd "$(dirname "$0")/.." && pwd)"

if [ -z "${CMUX_SURFACE_ID:-}" ]; then
  echo "[cdash] not running inside cmux." >&2
  echo "[cdash] open a cmux tab and run cdash there." >&2
  exit 1
fi

export CDASH_CAF_DIR="$CAF_DIR"
export CDASH_MAIN_SID="$CMUX_SURFACE_ID"
export CDASH_WID="${CMUX_WORKSPACE_ID:-}"
export CDASH_DASHBOARD_CMD="uv run python ${CAF_DIR}/dashboard/sprint_report.py --cwd ${PWD}"
export CDASH_REPORT_CMD="uv run python ${CAF_DIR}/dashboard/activity_report.py --cwd ${PWD}"

python3 <<'PYEOF'
import sys, os
sys.path.insert(0, os.environ['CDASH_CAF_DIR'] + '/lib')
import cmux_client as cmux

main_sid  = os.environ['CDASH_MAIN_SID']
wid       = os.environ['CDASH_WID']
dash_cmd  = os.environ['CDASH_DASHBOARD_CMD']
report_cmd = os.environ['CDASH_REPORT_CMD']

def split(from_sid):
    resp = cmux._call('surface.split', {
        'surface_id': from_sid,
        'workspace_id': wid,
        'direction': 'right',
    })
    if not resp.get('ok'):
        code = (resp.get('error') or {}).get('code', '')
        msg  = (resp.get('error') or {}).get('message', str(resp))
        if code in ('unavailable', 'not_found'):
            print('[cdash] cmux workspace not found — env vars stale. Open a fresh tab.', file=sys.stderr)
            sys.exit(1)
        print(f'[cdash] split failed: {msg}', file=sys.stderr)
        return None
    result = resp.get('result') or {}
    return result.get('surface_id') or result.get('id') or None

dash_sid = split(main_sid)
if not dash_sid:
    sys.exit(1)
cmux.send_surface(dash_sid, f'{dash_cmd}\n')

report_sid = split(dash_sid)
if report_sid:
    cmux.send_surface(report_sid, f'{report_cmd}\n')

cmux.focus_surface(main_sid)
print('[cdash] panels opened.')
PYEOF
